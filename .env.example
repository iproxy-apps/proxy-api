DATABASE_URL="postgresql://postgres:docker@localhost:5432/proxy?schema=public"
PORT=3333
NODE_ENV=development

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
# secret of the Dashboard endpoint registered for *Connected accounts*; optional locally where `stripe listen` delivers both families
STRIPE_CONNECT_WEBHOOK_SECRET=

DEV_CALLBACK_URL=
PROD_CALLBACK_URL=

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SES_FROM_EMAIL=noreply@yourdomain.com

# hops of reverse proxy to trust (1 on Railway/Render)
TRUST_PROXY=0

# proof photos: when S3_BUCKET is set, an S3-compatible store is used (Cloudflare R2 in production);
# otherwise files go to PROOF_DIR (default <cwd>/tmp/proofs)
# R2 example: S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com, S3_REGION=auto
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# PROOF_DIR=
