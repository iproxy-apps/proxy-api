DATABASE_URL="postgresql://postgres:docker@localhost:5432/proxy?schema=public"
PORT=3333
NODE_ENV=development

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

DEV_CALLBACK_URL=
