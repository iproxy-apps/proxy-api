generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  CLIENT
  PROXY
}

enum TaskStatus {
  available
  accepted
  on_the_way
  in_progress
  verification_required
  completed
  canceled
  payout_failed
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
  disputed
}

model Users {
  id                  String        @id @default(uuid()) @db.Uuid
  name                String
  email               String        @unique
  password            String
  phoneNumber         String?
  avatarUrl           String?
  userType            UserType
  rating              Decimal       @default(0) @db.Decimal(3, 2)
  totalTasksCompleted Int           @default(0)
  totalTasksCreated   Int           @default(0)
  walletBalance       Decimal       @default(0) @db.Decimal(12, 2)
  termsAccepted       Boolean       @default(false)
  stripeCustomerId    String?
  stripeAccountId     String?
  stripeAccountReady  Boolean       @default(false)
  payoutIssue         Boolean       @default(false)
  cardActionRequired  Boolean       @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  userTasks Tasks[] @relation("UserTasks")
  cards     Cards[]

  isDeleted          Boolean              @default(false)
  userTaskMappings   UserTaskMapping[]
  passwordResetCodes PasswordResetCodes[]
  refreshTokens      RefreshTokens[]
  ratingsGiven       Ratings[]            @relation("RatingsGiven")
  ratingsReceived    Ratings[]            @relation("RatingsReceived")

  @@map("users")
}

model Tasks {
  id String @id @default(uuid()) @db.Uuid

  owner String @db.Uuid

  title           String
  description     String
  locationLat     Decimal @db.Decimal(9, 6)
  locationLng     Decimal @db.Decimal(9, 6)
  locationAddress String

  offeredPrice  Decimal  @db.Decimal(10, 2)
  proxyEarnings Decimal? @db.Decimal(10, 2)
  platformFee   Decimal? @db.Decimal(10, 2)
  stripeFee     Decimal? @db.Decimal(10, 2)
  chargedAmount Decimal? @db.Decimal(10, 2)

  transferId String? @unique

  status TaskStatus @default(available)

  proofImageUrl String?

  startedAt   DateTime?
  completedAt DateTime?
  canceledAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId Users @relation("UserTasks", fields: [owner], references: [id], onDelete: Cascade)

  userTaskMappings UserTaskMapping[]
  payments         Payments[]
  rating           Ratings?

  @@map("tasks")
}

model Cards {
  id String @id @default(uuid()) @db.Uuid

  userId       String @db.Uuid
  stripeCardId String
  brand        String
  last4        String

  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cards")
}

model UserTaskMapping {
  taskId     String @id @db.Uuid
  executorId String @db.Uuid // user id

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user Users @relation(fields: [executorId], references: [id], onDelete: Cascade)
  task Tasks @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("user_task_mapping")
}

model Payments {
  id String @id @default(uuid()) @db.Uuid

  taskId        String        @db.Uuid
  paymentIntent String
  amount        Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(pending)
  refundId      String?
  chargeId      String?
  disputeId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Tasks @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([paymentIntent])
  @@index([taskId])
  @@map("payments")
}

model Ratings {
  id String @id @default(uuid()) @db.Uuid

  taskId  String @unique @db.Uuid
  raterId String @db.Uuid
  ratedId String @db.Uuid

  score   Int
  comment String?

  createdAt DateTime @default(now())

  task  Tasks @relation(fields: [taskId], references: [id], onDelete: Cascade)
  rater Users @relation("RatingsGiven", fields: [raterId], references: [id], onDelete: Cascade)
  rated Users @relation("RatingsReceived", fields: [ratedId], references: [id], onDelete: Cascade)

  @@map("ratings")
}

model StripeEvents {
  id        String   @id
  type      String
  createdAt DateTime @default(now())

  @@map("stripe_events")
}

enum PasswordResetCodeState {
  pending
  verified
  used
}

model PasswordResetCodes {
  id        String                 @id @default(uuid()) @db.Uuid
  userId    String                 @db.Uuid
  code      String
  expiresAt DateTime
  state     PasswordResetCodeState @default(pending)

  createdAt DateTime @default(now())

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_codes")
}

model RefreshTokens {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  familyId     String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  user Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
